<div class="size-chart__panel" style="max-width: 390px; border: 1px solid rgba(var(--text-color), .14); border-radius: 12px; margin: 2rem auto;">
  <p class="heading h6" style="margin: 0 0 1rem;">Essentials — Clothing</p>

  <section class="size-chart__section">
    <h2 class="size-chart__heading">Measurements</h2>
    {% render 'size-chart-table', raw: real_meas, caption: 'Garment measured flat, in centimetres.' %}
  </section>

  <section class="size-chart__section">
    <h2 class="size-chart__heading">Find your size</h2>
    {% render 'size-chart-grid', raw: real_grid, caption: 'Height down the side, weight across the top. Swipe the table sideways.' %}
  </section>
</div>
