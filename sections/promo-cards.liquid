{%- comment -%}
  ============================================================================
  Promo cards (sections/promo-cards.liquid)
  ----------------------------------------------------------------------------
  2–4 large image cards that link to collections ("Shop by category").
  Each card is a block. If a card has no image of its own, it uses the
  collection's image, then the first product's image, so it never looks empty.

  What this section teaches:
    - {% liquid %} tag for logic without lots of {% %} tags
    - section.settings (whole section) vs block.settings (one card)
    - fallbacks: use the collection's data when a field is left empty
    - responsive images with image_url + image_tag
    - CSS: static rules in {% stylesheet %}, setting-driven values in <style>
  ============================================================================
{%- endcomment -%}

{%- liquid
  case section.settings.card_shape
    when 'square'
      assign card_ratio = '1 / 1'
    when 'landscape'
      assign card_ratio = '4 / 3'
    else
      assign card_ratio = '4 / 5'
  endcase

  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
-%}

{%- comment -%} Values that change per section instance go in <style>, scoped to this section's id {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} {
    --promo-columns: {{ section.settings.columns_desktop }};
    --promo-ratio: {{ card_ratio }};
    --promo-overlay: {{ overlay }};
    --promo-text-color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<div class="promo-cards">
  <div class="container">
    {%- if section.settings.subheading != blank or section.settings.heading != blank -%}
      <header class="promo-cards__header">
        {%- if section.settings.subheading != blank -%}
          <p class="heading heading--small">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="promo-cards__grid{% if section.settings.mobile_scroll %} promo-cards__grid--scroll{% endif %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_collection = block.settings.collection

          # Fallbacks: if the merchant leaves a field empty, take it from the collection
          assign card_image = block.settings.image
          if card_image == blank and card_collection != blank
            assign card_image = card_collection.featured_image
          endif
          if card_image == blank and card_collection != blank
            assign card_image = card_collection.products.first.featured_image
          endif

          assign card_title = block.settings.title
          if card_title == blank and card_collection != blank
            assign card_title = card_collection.title
          endif

          assign card_link = block.settings.link
          if card_link == blank and card_collection != blank
            assign card_link = card_collection.url
          endif
        -%}

        <a class="promo-card"
          {% if card_link != blank %}href="{{ card_link }}"{% endif %}
          {{ block.shopify_attributes }}>
          <div class="promo-card__media">
            {%- if card_image != blank -%}
              {{
                card_image
                | image_url: width: 1400
                | image_tag:
                  class: 'promo-card__image',
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200, 1400',
                  sizes: '(max-width: 740px) 80vw, (max-width: 999px) 50vw, 33vw',
                  alt: card_title
              }}
            {%- else -%}
              {%- assign placeholder_name = 'collection-' | append: forloop.index -%}
              {{ placeholder_name | placeholder_svg_tag: 'promo-card__image promo-card__placeholder' }}
            {%- endif -%}
          </div>

          <div class="promo-card__content">
            {%- if block.settings.label != blank -%}
              <span class="promo-card__label">{{ block.settings.label | escape }}</span>
            {%- endif -%}

            {%- if card_title != blank -%}
              <h3 class="promo-card__title">{{ card_title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.button_text != blank -%}
              <span class="promo-card__button">{{ block.settings.button_text | escape }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} Static CSS: the same for every instance. Shopify bundles it into one file {%- endcomment -%}
{% stylesheet %}
  .promo-cards__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .promo-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--promo-columns), minmax(0, 1fr));
    gap: 16px;
  }

  .promo-card {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: var(--promo-ratio);
    border-radius: 12px;
    background: #f3f3f3;
    color: var(--promo-text-color);
    text-decoration: none;
  }

  .promo-card__media,
  .promo-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .promo-card__image {
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .promo-card:hover .promo-card__image {
    transform: scale(1.05);
  }

  /* Dark gradient at the bottom so white text is readable on any photo */
  .promo-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, var(--promo-overlay)) 0%, rgba(0, 0, 0, 0) 65%);
    pointer-events: none;
  }

  .promo-card__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 24px;
  }

  .promo-card__label {
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .promo-card__title {
    margin: 0;
    color: inherit;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .promo-card__button {
    padding-bottom: 2px;
    border-bottom: 2px solid currentColor;
    font-size: 14px;
    font-weight: 600;
  }

  /* Tablet: at most 2 cards per row */
  @media screen and (min-width: 741px) and (max-width: 999px) {
    .promo-cards__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Phone: one per row, or a swipeable row if "Swipe on mobile" is on */
  @media screen and (max-width: 740px) {
    .promo-cards__grid {
      grid-template-columns: 1fr;
    }

    .promo-cards__grid--scroll {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 80%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .promo-cards__grid--scroll::-webkit-scrollbar {
      display: none;
    }

    .promo-cards__grid--scroll .promo-card {
      scroll-snap-align: start;
    }

    .promo-card__title {
      font-size: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo cards",
  "tag": "section",
  "class": "shopify-section--promo-cards",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your fit"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "card_shape",
      "label": "Card shape",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "mobile_scroll",
      "label": "Swipe on mobile",
      "info": "Off: cards stack one under another on phones.",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image darkening",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Used for the link, title and image when those are left empty."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. 1200 x 1500px recommended."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Small pill above the title, e.g. New in."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave empty to use the collection title."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to link to the collection."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo cards",
      "blocks": [
        {
          "type": "card",
          "settings": { "label": "New in", "title": "Sneakers" }
        },
        {
          "type": "card",
          "settings": { "label": "Everyday", "title": "Essentials" }
        },
        {
          "type": "card",
          "settings": { "label": "Up to 40% off", "title": "Sale" }
        }
      ]
    }
  ]
}
{% endschema %}
