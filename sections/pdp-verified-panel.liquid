{%- comment -%}
  How every piece is verified (matching PDP prototype).
  id="verify" is what the gallery seal and buy box verified line link to.
{%- endcomment -%}

{%- if section.blocks.size > 0 or request.design_mode -%}
  {{ 'pdp-verified-panel.css' | asset_url | stylesheet_tag }}

  {%- assign seal_alt = section.settings.seal_alt | default: settings.pdp_seal_alt | default: '100% Authentic — guaranteed every time' -%}

  <section class="pdp-vp" id="verify">
    <div class="container">
      <div class="pdp-vp__head">
        {%- if section.settings.seal_image != blank -%}
          {{ section.settings.seal_image | image_url: width: 128 | image_tag: class: 'pdp-vp__seal', loading: 'lazy', width: 64, height: 64, alt: seal_alt }}
        {%- elsif settings.pdp_seal_image != blank -%}
          {{ settings.pdp_seal_image | image_url: width: 128 | image_tag: class: 'pdp-vp__seal', loading: 'lazy', width: 64, height: 64, alt: seal_alt }}
        {%- else -%}
          <img class="pdp-vp__seal" src="{{ 'pdp-seal.png' | asset_url }}" width="64" height="64" alt="{{ seal_alt | escape }}" loading="lazy">
        {%- endif -%}

        <div class="pdp-vp__head-text">
          {%- if section.settings.heading != blank -%}
            <h2 class="pdp-vp__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="pdp-vp__lead">{{ section.settings.intro | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="pdp-vp__grid">
          {%- for block in section.blocks -%}
            {%- assign step_num = forloop.index -%}
            {%- if step_num < 10 -%}
              {%- assign step_num = '0' | append: step_num -%}
            {%- endif -%}
            <div class="pdp-vp__card" {{ block.shopify_attributes }}>
              <span class="pdp-vp__num">{{ block.settings.step_label | default: 'STEP ' | append: step_num }}</span>
              <span class="pdp-vp__icon" aria-hidden="true">
                {%- if block.settings.icon_image != blank -%}
                  {{ block.settings.icon_image | image_url: width: 48 | image_tag: loading: 'lazy', width: 18, height: 18, alt: '' }}
                {%- elsif block.settings.icon == 'box' or block.settings.icon == 'picto-box' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4z"/><path d="M3 7v10l9 4 9-4V7"/></svg>
                {%- elsif block.settings.icon == 'search' or block.settings.icon == 'header-search' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
                {%- elsif block.settings.icon == 'truck' or block.settings.icon == 'picto-delivery-truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h13v8H3z"/><path d="M16 10h3l2 3v2h-5z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
                {%- elsif block.settings.icon == 'shield' or block.settings.icon == 'picto-warranty' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- else -%}
                  {%- render 'icon', icon: block.settings.icon, width: 18, height: 18 -%}
                {%- endif -%}
              </span>
              <h3 class="pdp-vp__card-title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="pdp-vp__card-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <a class="pdp-vp__link" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "How it's verified",
  "tag": "section",
  "class": "shopify-section--pdp-verified-panel",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How every piece is verified" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Fakes are the one thing you shouldn't have to worry about. Here's exactly what happens before an order leaves us." },
    {
      "type": "image_picker",
      "id": "seal_image",
      "label": "Seal image",
      "info": "Falls back to the seal set in Theme settings, then to the bundled CoppedAU seal."
    },
    { "type": "text", "id": "seal_alt", "label": "Seal alt text", "info": "Falls back to the alt text set in Theme settings." },
    { "type": "text", "id": "link_label", "label": "Link label", "info": "Optional. Shown under the steps with the link URL." },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "box",
          "options": [
            { "value": "box", "label": "Box (prototype)" },
            { "value": "search", "label": "Search / Inspect (prototype)" },
            { "value": "truck", "label": "Delivery truck (prototype)" },
            { "value": "shield", "label": "Shield (prototype)" },
            { "value": "picto-box", "label": "Theme Box" },
            { "value": "header-search", "label": "Theme Search" },
            { "value": "picto-delivery-truck", "label": "Theme Delivery truck" },
            { "value": "picto-warranty", "label": "Theme Warranty" }
          ]
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" },
        { "type": "text", "id": "step_label", "label": "Step label prefix", "default": "STEP " },
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it's verified",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "box",
            "title": "Sourced from trusted retailers",
            "text": "We buy through authorised retail channels only — never unknown third-party sellers."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "search",
            "title": "Inspected in-house",
            "text": "Each item is checked by hand against retail references — tags, stitching, hardware and print."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "truck",
            "title": "Dispatched sealed from Melbourne",
            "text": "Packed and shipped tracked from our Melbourne HQ, usually within 1–2 business days."
          }
        }
      ]
    }
  ]
}
{% endschema %}
