{%- comment -%}
  Free shipping threshold, in cents, for the current currency.

  Prints a number: 0 when free shipping is switched off in Theme settings > Cart
  or no amount matches this currency. Capture it and add 0 to get a number:

    {%- capture threshold -%}{%- render 'cart-free-shipping-threshold' -%}{%- endcapture -%}
    {%- assign threshold = threshold | plus: 0 -%}

  Same parsing as Focal's own cart: one amount ("300"), or one per currency
  ("AUD:300,USD:200").
{%- endcomment -%}

{%- liquid
  assign threshold_cents = 0

  if settings.cart_show_free_shipping_threshold and settings.cart_free_shipping_threshold != blank
    assign thresholds = settings.cart_free_shipping_threshold | remove: ' ' | split: ','

    if thresholds.size > 1
      for threshold in thresholds
        assign threshold_parts = threshold | split: ':'
        assign currency_code = threshold_parts | first | upcase
        if currency_code == cart.currency.iso_code
          assign threshold_cents = threshold_parts | last | times: 100 | round
          break
        endif
      endfor
    else
      assign threshold_cents = thresholds | last | split: ':' | last | times: 100 | round
    endif
  endif
-%}
{{- threshold_cents -}}
