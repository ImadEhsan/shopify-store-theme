{%- comment -%}
  One product as JSON for the bundle builder.

  In: product (required)

  Shared by templates/collection.bundle-json.liquid, templates/search.bundle-json.liquid
  and the builder's own config (the product being viewed), so the sheet reads
  one shape wherever a product comes from. Prices are in cents.
{%- endcomment -%}
{
  "id": {{ product.id }},
  "title": {{ product.title | json }},
  "vendor": {{ product.vendor | json }},
  "url": {{ product.url | json }},
  "image": {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %},
  "single": {% if product.has_only_default_variant %}true{% else %}false{% endif %},
  "variants": [
    {%- for variant in product.variants -%}
      {"id": {{ variant.id }}, "title": {{ variant.title | json }}, "price": {{ variant.price }}, "compare": {{ variant.compare_at_price | default: 0 }}, "available": {% if variant.available %}true{% else %}false{% endif %}}
      {%- unless forloop.last %},{% endunless -%}
    {%- endfor -%}
  ]
}
