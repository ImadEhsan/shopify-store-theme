  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "message",
            "label": "Message"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "message"
      },
      {
        "type": "select",
        "id": "cart_icon",
        "label": "Cart icon",
        "options": [
          {
            "value": "shopping_bag",
            "label": "Shopping bag"
          },
          {
            "value": "shopping_cart",
            "label": "Shopping cart"
          },
          {
            "value": "tote_bag",
            "label": "Tote bag"
          }
        ],
        "default": "shopping_bag"
      },
      {
        "type": "checkbox",
        "id": "cart_show_free_shipping_threshold",
        "label": "Show free shipping minimum amount",
        "info": "Make sure that you have properly configured your [shipping rates](/admin/settings/shipping).",
        "default": false
      },
      {
        "type": "text",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping minimum amount",
        "info": "Enter amount using number only. If using multiple currencies, separate each currency code with its amount (eg.: USD:50,EUR:60,JPY:9000)",
        "default": "50",
        "visible_if": "{{ settings.cart_show_free_shipping_threshold }}"
      }
    ]
  },
  {
    "name": "Bundle & rewards",
    "settings": [
      {
        "type": "paragraph",
        "content": "One tier ladder for the product page's Bundle & save block, the bundle builder and the cart drawer's rewards bar. Free shipping on the rewards bar uses the free shipping amount under Cart."
      },
      {
        "type": "select",
        "id": "bundle_discount_type",
        "label": "Discount type",
        "options": [
          { "value": "percent", "label": "Percent off" },
          { "value": "amount", "label": "Amount off each item" }
        ],
        "default": "percent",
        "info": "Changes how the second number in each tier is read. It changes what the page shows, not what checkout charges \u2014 the discount in Shopify has to be switched to match."
      },
      {
        "type": "text",
        "id": "bundle_tiers",
        "label": "Bundle tiers",
        "default": "2|10, 3|15, 4|20",
        "info": "Format: items|value, comma between tiers. The value is a percentage or an amount off each item, depending on Discount type \u2014 so \"2|10\" is either 10% off or $10 off each. It must match the automatic discount in Shopify, or the checkout total will differ from the page. The drawer's saving always shows the discount Shopify actually applied."
      },
      {
        "type": "header",
        "content": "Shipping protection"
      },
      {
        "type": "checkbox",
        "id": "cart_protection_enabled",
        "label": "Show shipping protection in the cart drawer",
        "default": false,
        "info": "Added to the bag with the first item; the shopper can switch it off. It is never counted as an item, toward the bundle tiers or toward free shipping. Exclude this product from the automatic bundle discount in Shopify, and turn off any other shipping protection app."
      },
      {
        "type": "product",
        "id": "cart_protection_product",
        "label": "Protection product",
        "info": "Its first variant is added. Set it to not require shipping."
      },
      {
        "type": "text",
        "id": "cart_protection_text",
        "label": "Description",
        "default": "covers loss, theft & damage",
        "visible_if": "{{ settings.cart_protection_enabled }}"
      }
    ]
  },
