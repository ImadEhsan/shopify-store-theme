  {
    "name": "Product page (CoppedAU)",
    "settings": [
      {
        "type": "header",
        "content": "Gallery"
      },
      {
        "type": "image_picker",
        "id": "pdp_seal_image",
        "label": "Authenticity seal"
      },
      {
        "type": "text",
        "id": "pdp_seal_alt",
        "label": "Seal description",
        "default": "100% Authentic — guaranteed every time"
      },
      {
        "type": "header",
        "content": "Buy box"
      },
      {
        "type": "text",
        "id": "pdp_trust_line",
        "label": "Trust line by the rating",
        "default": "Trusted by 10,000+",
        "info": "Shown after the review count. Clear it if the claim cannot be substantiated."
      },
      {
        "type": "checkbox",
        "id": "pdp_show_bnpl",
        "label": "Show the Afterpay / Zip instalment row",
        "default": true
      },
      {
        "type": "range",
        "id": "pdp_bnpl_count",
        "label": "Instalments",
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 4
      },
      {
        "type": "header",
        "content": "Reviews (Loox)"
      },
      {
        "type": "paragraph",
        "content": "Set once here and every reviews section on the store uses it. Find the ID in the Loox admin under Settings \u2192 API Keys. It is safe to expose: the Storefront API only accepts calls from your own domain. Requires Loox's Convert or Unlimited plan."
      },
      {
        "type": "text",
        "id": "loox_public_store_id",
        "label": "Loox public store ID"
      },
      {
        "type": "header",
        "content": "Size picker"
      },
      {
        "type": "range",
        "id": "pdp_low_stock_threshold",
        "label": "Low stock threshold",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 5,
        "info": "A size with this many or fewer in stock shows \"Low stock\". Anything above it shows nothing. Set to 0 to never show it."
      },
      {
        "type": "header",
        "content": "Dispatch"
      },
      {
        "type": "text",
        "id": "pdp_ship_fallback",
        "label": "Dispatch line",
        "default": "Dispatched within 1-2 business days",
        "info": "Shown on every product. Per-product dispatch times are parked until descriptions separate dispatch from delivery."
      }
