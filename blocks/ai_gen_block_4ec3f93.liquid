{% doc %}
  @prompt
    Generate a section to promote user generated content. I need to upload a video or image, along with a title and description of the video. Include two buttons to link the product and a social media account. Do not include any icons in the button. I need to post up to five videos at one time, each with a title and description. One video should show at a time, with the second post showing on the right-hand side of the page, to scroll across to. The text should sit on the left hand side, and the video on the right, split evenly down the page. The video or image must retain a 9:16 ratio, with a max-height of 650px. Include a carousel navigation in the same style as the theme.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ugc-carousel-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .ai-ugc-carousel__container-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-ugc-carousel__slide-{{ ai_gen_id }} {
    min-width: 100%;
    display: flex;
    align-items: center;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-ugc-carousel__content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 40px;
  }

  .ai-ugc-carousel__title-{{ ai_gen_id }} {
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-weight: {{ settings.heading_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    text-transform: {{ settings.heading_text_transform }};
  }

  .ai-ugc-carousel__description-{{ ai_gen_id }} {
    font-family: {{ settings.text_font.family }}, {{ settings.text_font.fallback_families }};
    font-weight: {{ settings.text_font.weight }};
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-ugc-carousel__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-ugc-carousel__button-{{ ai_gen_id }} {
    padding: 12px 24px;
    text-decoration: none;
    border-radius: {{ settings.button_border_radius }}px;
    font-family: {{ settings.text_font.family }}, {{ settings.text_font.fallback_families }};
    font-weight: {{ settings.text_font.weight }};
    font-size: 14px;
    transition: all 0.3s ease;
    display: inline-block;
    border: 2px solid transparent;
  }

  .ai-ugc-carousel__button--primary-{{ ai_gen_id }} {
    background-color: {{ settings.primary_button_background }};
    color: {{ settings.primary_button_text_color }};
    border-color: {{ settings.primary_button_background }};
  }

  .ai-ugc-carousel__button--primary-{{ ai_gen_id }}:hover {
    opacity: 0.85;
  }

  .ai-ugc-carousel__button--secondary-{{ ai_gen_id }} {
    background-color: {{ settings.secondary_button_background }};
    color: {{ settings.secondary_button_text_color }};
    border-color: {{ settings.secondary_button_background }};
  }

  .ai-ugc-carousel__button--secondary-{{ ai_gen_id }}:hover {
    opacity: 0.85;
  }

  .ai-ugc-carousel__media-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }

  .ai-ugc-carousel__media-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-height: 650px;
    aspect-ratio: 9 / 16;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.media_border_radius }}px;
  }

  .ai-ugc-carousel__media-wrapper-{{ ai_gen_id }} img,
  .ai-ugc-carousel__media-wrapper-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-ugc-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-ugc-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ugc-carousel__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-ugc-carousel__navigation-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
    padding: 0 40px 40px;
  }

  .ai-ugc-carousel__nav-button-{{ ai_gen_id }} {
    background: none;
    border: 2px solid {{ block.settings.nav_color }};
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    color: {{ block.settings.nav_color }};
  }

  .ai-ugc-carousel__nav-button-{{ ai_gen_id }}:hover:not(:disabled) {
    background-color: {{ block.settings.nav_color }};
    color: {{ block.settings.nav_hover_color }};
  }

  .ai-ugc-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-ugc-carousel__nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke-width: {{ settings.icon_stroke_width }};
  }

  .ai-ugc-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-ugc-carousel__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_color }};
    opacity: 0.3;
    transition: opacity 0.3s ease;
    cursor: pointer;
  }

  .ai-ugc-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 989px) {
    .ai-ugc-carousel__slide-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-ugc-carousel__content-{{ ai_gen_id }},
    .ai-ugc-carousel__media-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-ugc-carousel__navigation-{{ ai_gen_id }} {
      padding: 0 20px 20px;
    }

    .ai-ugc-carousel__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-ugc-carousel__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<ugc-carousel-{{ ai_gen_id }} class="ai-ugc-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ugc-carousel__container-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign post_enabled_key = 'post_' | append: i | append: '_enabled'
        assign post_title_key = 'post_' | append: i | append: '_title'
        assign post_description_key = 'post_' | append: i | append: '_description'
        assign post_media_key = 'post_' | append: i | append: '_media'
        assign post_video_key = 'post_' | append: i | append: '_video'
        assign post_button1_text_key = 'post_' | append: i | append: '_button1_text'
        assign post_button1_link_key = 'post_' | append: i | append: '_button1_link'
        assign post_button2_text_key = 'post_' | append: i | append: '_button2_text'
        assign post_button2_link_key = 'post_' | append: i | append: '_button2_link'

        assign post_enabled = block.settings[post_enabled_key]
        assign post_title = block.settings[post_title_key]
        assign post_description = block.settings[post_description_key]
        assign post_media = block.settings[post_media_key]
        assign post_video = block.settings[post_video_key]
        assign post_button1_text = block.settings[post_button1_text_key]
        assign post_button1_link = block.settings[post_button1_link_key]
        assign post_button2_text = block.settings[post_button2_text_key]
        assign post_button2_link = block.settings[post_button2_link_key]
      %}

      {% if post_enabled %}
        <div class="ai-ugc-carousel__slide-{{ ai_gen_id }}" data-slide="{{ i }}">
          <div class="ai-ugc-carousel__content-{{ ai_gen_id }}">
            {% if post_title != blank %}
              <h2 class="ai-ugc-carousel__title-{{ ai_gen_id }}">{{ post_title }}</h2>
            {% endif %}

            {% if post_description != blank %}
              <div class="ai-ugc-carousel__description-{{ ai_gen_id }}">
                {{ post_description }}
              </div>
            {% endif %}

            <div class="ai-ugc-carousel__buttons-{{ ai_gen_id }}">
              {% if post_button1_text != blank and post_button1_link != blank %}
                <a
                  href="{{ post_button1_link }}"
                  class="ai-ugc-carousel__button-{{ ai_gen_id }} ai-ugc-carousel__button--primary-{{ ai_gen_id }}"
                >
                  {{ post_button1_text }}
                </a>
              {% endif %}

              {% if post_button2_text != blank and post_button2_link != blank %}
                <a
                  href="{{ post_button2_link }}"
                  class="ai-ugc-carousel__button-{{ ai_gen_id }} ai-ugc-carousel__button--secondary-{{ ai_gen_id }}"
                >
                  {{ post_button2_text }}
                </a>
              {% endif %}
            </div>
          </div>

          <div class="ai-ugc-carousel__media-{{ ai_gen_id }}">
            <div class="ai-ugc-carousel__media-wrapper-{{ ai_gen_id }}">
              {% if post_video != blank %}
                <video
                  src="{{ post_video }}"
                  playsinline
                  {% if block.settings.autoplay %}autoplay{% endif %}
                  {% if block.settings.loop %}loop{% endif %}
                  {% if block.settings.muted %}muted{% endif %}
                  {% if block.settings.controls %}controls{% endif %}
                ></video>
              {% elsif post_media != blank %}
                <img
                  src="{{ post_media | image_url: width: 800 }}"
                  alt="{{ post_title | escape }}"
                  loading="lazy"
                  width="{{ post_media.width }}"
                  height="{{ post_media.height }}"
                >
              {% else %}
                <div class="ai-ugc-carousel__placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-ugc-carousel__empty-state-{{ ai_gen_id }}">
                    Add an image or video
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="ai-ugc-carousel__navigation-{{ ai_gen_id }}">
    <button
      class="ai-ugc-carousel__nav-button-{{ ai_gen_id }}"
      data-direction="prev"
      aria-label="Previous slide"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="ai-ugc-carousel__dots-{{ ai_gen_id }}"></div>

    <button
      class="ai-ugc-carousel__nav-button-{{ ai_gen_id }}"
      data-direction="next"
      aria-label="Next slide"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</ugc-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class UgcCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
      }

      connectedCallback() {
        this.container = this.querySelector('.ai-ugc-carousel__container-{{ ai_gen_id }}');
        this.slides = Array.from(this.querySelectorAll('.ai-ugc-carousel__slide-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('[data-direction="prev"]');
        this.nextButton = this.querySelector('[data-direction="next"]');
        this.dotsContainer = this.querySelector('.ai-ugc-carousel__dots-{{ ai_gen_id }}');

        if (this.slides.length === 0) return;

        this.createDots();
        this.setupEventListeners();
        this.updateCarousel();
      }

      createDots() {
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.className = 'ai-ugc-carousel__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.navigate(-1));
        this.nextButton.addEventListener('click', () => this.navigate(1));

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.container.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.container.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.container.addEventListener('touchend', () => {
          if (!isDragging) return;
          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.navigate(1);
            } else {
              this.navigate(-1);
            }
          }
          isDragging = false;
        });
      }

      navigate(direction) {
        const newSlide = this.currentSlide + direction;
        if (newSlide >= 0 && newSlide < this.slides.length) {
          this.goToSlide(newSlide);
        }
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const offset = -this.currentSlide * 100;
        this.container.style.transform = `translateX(${offset}%)`;

        this.prevButton.disabled = this.currentSlide === 0;
        this.nextButton.disabled = this.currentSlide === this.slides.length - 1;

        const dots = this.dotsContainer.querySelectorAll('.ai-ugc-carousel__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('ugc-carousel-{{ ai_gen_id }}', UgcCarousel{{ ai_gen_id }});
  })();
</script>

