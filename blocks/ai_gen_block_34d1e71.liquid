{% doc %}
  @prompt
    Generate a logo grid carousel with continuous auto-scroll. Once the logos end, it should start instantly again, never breaking. Each logo should be a link to a collection page. The carousel should be a stand-alone component, treat it as a shopify-section. The animation should take 15 seconds., Add slider to change animation speed, Hide unused logo slots
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-carousel-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: 60px 0px;
    position: relative;
  }

  .ai-logo-carousel-{{ ai_gen_id }}::after {
    content: "";
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 0;
    height: 1px;
    background-color: #ffffff;
  }

  @media screen and (min-width: 1000px) {
    .ai-logo-carousel-{{ ai_gen_id }}::after {
      left: 30%;
      right: 30%;
    }
  }

  .ai-logo-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.logo_spacing }}px;
    animation: ai-logo-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-logo-carousel__slide-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_height }}px;
  }

  .ai-logo-carousel__link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    transition: opacity 0.3s ease;
  }

  .ai-logo-carousel__link-{{ ai_gen_id }}:hover {
    opacity: {{ block.settings.hover_opacity | divided_by: 100.0 }};
  }

  .ai-logo-carousel__image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale({{ block.settings.grayscale_amount }}%);
    transition: filter 0.3s ease;
  }

  .ai-logo-carousel__link-{{ ai_gen_id }}:hover .ai-logo-carousel__image-{{ ai_gen_id }} {
    filter: grayscale(0%);
  }

  @keyframes ai-logo-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-100% - {{ block.settings.logo_spacing }}px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-logo-carousel__track-{{ ai_gen_id }} {
      animation: none;
    }
  }
{% endstyle %}

<div class="ai-logo-carousel ai-logo-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-carousel__track-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% liquid
        assign logo_key = 'logo_' | append: i
        assign collection_key = 'collection_' | append: i
        assign logo = block.settings[logo_key]
        assign collection = block.settings[collection_key]
      %}
      
      {% if logo != blank %}
        <div class="ai-logo-carousel__slide-{{ ai_gen_id }}">
          {% if collection != blank %}
            <a href="{{ collection.url }}" class="ai-logo-carousel__link-{{ ai_gen_id }}">
              <img
                src="{{ logo | image_url: width: 400 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="{{ block.settings.logo_width }}"
                height="{{ block.settings.logo_height }}"
                class="ai-logo-carousel__image-{{ ai_gen_id }}"
              >
            </a>
          {% else %}
            <div class="ai-logo-carousel__link-{{ ai_gen_id }}">
              <img
                src="{{ logo | image_url: width: 400 }}"
                alt="Logo {{ i }}"
                loading="lazy"
                width="{{ block.settings.logo_width }}"
                height="{{ block.settings.logo_height }}"
                class="ai-logo-carousel__image-{{ ai_gen_id }}"
              >
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {% for i in (1..8) %}
      {% liquid
        assign logo_key = 'logo_' | append: i
        assign collection_key = 'collection_' | append: i
        assign logo = block.settings[logo_key]
        assign collection = block.settings[collection_key]
      %}
      
      {% if logo != blank %}
        <div class="ai-logo-carousel__slide-{{ ai_gen_id }}">
          {% if collection != blank %}
            <a href="{{ collection.url }}" class="ai-logo-carousel__link-{{ ai_gen_id }}">
              <img
                src="{{ logo | image_url: width: 400 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="{{ block.settings.logo_width }}"
                height="{{ block.settings.logo_height }}"
                class="ai-logo-carousel__image-{{ ai_gen_id }}"
              >
            </a>
          {% else %}
            <div class="ai-logo-carousel__link-{{ ai_gen_id }}">
              <img
                src="{{ logo | image_url: width: 400 }}"
                alt="Logo {{ i }}"
                loading="lazy"
                width="{{ block.settings.logo_width }}"
                height="{{ block.settings.logo_height }}"
                class="ai-logo-carousel__image-{{ ai_gen_id }}"
              >
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

